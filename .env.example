# Copiá este archivo a .env (en el server) y completá los valores reales.
# NO lo subas a git con valores reales.

# Dominio público (sin https://). Caddy lo usa para el certificado TLS.
DOMAIN=tudominio.com

# URL pública completa. La usan Better Auth y el cliente.
# OJO: NEXT_PUBLIC_* se hornean en el build → esto debe ser la URL final.
PUBLIC_URL=https://tudominio.com

# Postgres (lo levanta el propio compose).
POSTGRES_PASSWORD=cambiar-por-uno-fuerte

# Secreto de sesión de Better Auth. Generalo con: openssl rand -base64 32
BETTER_AUTH_SECRET=cambiar

# Claves VAPID para web-push. Generalas con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:vos@tudominio.com
