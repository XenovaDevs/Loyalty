// Sello — modelo de fidelización multi-comercio (event-sourced).
// Base: PostgreSQL (dev y prod). Los "enums" se guardan como String por simplicidad.
// El saldo de sellos/puntos NUNCA se guarda como contador mutable:
// se deriva sumando los LoyaltyEvent de cada Membership.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenancy ──────────────────────────────────────────────────────────────

model Business {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  city      String?
  plan      String   @default("START") // START | GROW | BUSINESS
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // QR único del local (/q/[joinToken]): el cliente lo escanea para darse de
  // alta y, las veces siguientes, para sumar un sello. Aleatorio (no el slug)
  // para que no se pueda adivinar la URL; el dueño lo puede regenerar.
  joinToken String @unique @default(dbgenerated("replace((gen_random_uuid())::text, '-'::text, ''::text)"))

  // Ubicación del local (para el aviso de cercanía).
  latitude  Float?
  longitude Float?
  mapsUrl   String? // link de Google Maps del local (se derivan lat/long)
  // Horario (0-23); null = sin restricción. Los sellos por QR solo se suman
  // con el local abierto.
  openHour  Int?
  closeHour Int?

  // Aviso de cercanía del local: notifica al cliente cuando pasa cerca.
  notifyEnabled   Boolean @default(false)
  notifyMessages  String? // JSON: array de textos; se elige uno al azar en cada aviso
  notifyRadiusM   Int     @default(120) // radio del aviso en metros
  notifyStartHour Int? // franja del aviso (0-23); null = usa el horario del local
  notifyEndHour   Int?

  users     User[]
  programs  Program[]
  customers Customer[]
}

// ─── Usuarios del comercio + auth (Better Auth) ─────────────────────────────

model User {
  id            String   @id @default(cuid())
  name          String
  email         String   @unique // interno y aleatorio (@sin-email.invalid): el login es por usuario
  emailVerified Boolean  @default(false)
  // Login por usuario (plugin `username` de Better Auth). Guardado en minúsculas.
  username        String? @unique
  displayUsername String?
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Dominio: a qué comercio pertenece y con qué rol.
  businessId String?
  role       String  @default("STAFF") // OWNER | STAFF

  business Business?      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  events   LoyaltyEvent[] @relation("StaffEvents")
  sessions Session[]
  accounts Account[]

  @@index([businessId])
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ─── Programas de fidelización ──────────────────────────────────────────────

model Program {
  id         String  @id @default(cuid())
  businessId String
  type       String // STAMPS | COUPON (un solo STAMPS activo por comercio: el QR suma ahí)
  name       String
  rewardText String // "Comprá 10, el 11 gratis"
  active     Boolean @default(true)

  // Reglas según tipo (nullable: solo aplican las del tipo correspondiente)
  stampsRequired    Int? // STAMPS
  pointsPerCurrency Decimal? // POINTS/CASHBACK: pts por $1 (sin uso)
  couponCode        String? // COUPON
  couponExpiresAt   DateTime?

  // Diseño de la tarjeta (logo, colores) serializado como JSON string.
  design String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships Membership[]

  @@index([businessId])
}

// ─── Clientes y membresías ──────────────────────────────────────────────────

model Customer {
  id         String   @id @default(cuid())
  businessId String
  name       String
  phone      String?
  // Teléfono normalizado (src/lib/phone.ts): una tarjeta por cliente por comercio.
  phoneKey   String?
  email      String?
  code       String @unique // código corto para QR/caja; único globalmente (la URL pública /t/[code] no lleva comercio)
  createdAt  DateTime @default(now())

  business      Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  memberships   Membership[]
  subscriptions PushSubscription[]

  @@unique([businessId, code])
  @@unique([businessId, phoneKey])
  @@index([businessId])
}

model PushSubscription {
  id         String   @id @default(cuid())
  customerId String
  endpoint   String   @unique
  p256dh     String
  auth       String
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model Membership {
  id         String   @id @default(cuid())
  programId  String
  customerId String
  createdAt  DateTime @default(now())

  program  Program        @relation(fields: [programId], references: [id], onDelete: Cascade)
  customer Customer       @relation(fields: [customerId], references: [id], onDelete: Cascade)
  events   LoyaltyEvent[]

  @@unique([programId, customerId])
  @@index([customerId])
}

// ─── Eventos (fuente de verdad del saldo) ───────────────────────────────────

model LoyaltyEvent {
  id           String   @id @default(cuid())
  membershipId String
  type         String // STAMP | POINTS | REDEEM | ADJUST
  amount       Decimal // sellos sumados, puntos ganados, o canje
  note         String?
  staffUserId  String?
  createdAt    DateTime @default(now())

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  staff      User?      @relation("StaffEvents", fields: [staffUserId], references: [id], onDelete: SetNull)

  @@index([membershipId])
  @@index([createdAt])
}
